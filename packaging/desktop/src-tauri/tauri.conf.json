{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cobble",
  "version": "1.42.0",
  "identifier": "io.github.drsamonline.cobble",
  "build": {
    "frontendDist": "../../app"
  },
  "app": {
    "windows": [
      {
        "title": "Cobble",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
